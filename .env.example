# The fixture app and deterministic experiment runner need no secrets.
# Never put provider secrets in NEXT_PUBLIC_* variables.
# Shared rooms at /pilot. These are public client credentials;
# do not substitute a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Paid image generation, used only by the server/worker. Never browser public.
OPENAI_API_KEY=
# Hold-to-talk transcription. Server only; never NEXT_PUBLIC_.
# The separate pilot_assist_limits allowance starts disabled.
CARTESIA_API_KEY=
# Server and worker only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional local operator refill button. Keep disabled on hosted environments.
# Adds room/request/guest test capacity; never raises the API dollar ceiling.
PILOT_LOCAL_CONTROLS=0
TRIGGER_SECRET_KEY=
# Use a Development key locally. Hosted Vercel uses a separate Production
# Trigger-only key; keep production overrides in ignored .env.production.local.
# npm run hosting:prepare creates separate private web/worker settings.
# Public HTTPS origin for /demo's QR, e.g. the Vercel production origin.
# Set this locally too so your local presentation points to the public signup.
FORK_NIGHT_PUBLIC_URL=
# Standalone Cloudflare signup uses SUPABASE_URL as a runtime variable.
# The local app can also reuse NEXT_PUBLIC_SUPABASE_URL above.
SUPABASE_URL=
# The public project reference is in trigger.config.ts; no PROJECT_REF is needed.

# Original-room release payouts: public configuration, baked into the app build.
# Only Monad testnet (10143) or the local EVM (31337) is accepted.
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RELEASE_ADDRESS=
NEXT_PUBLIC_MONAD_CURATOR_ADDRESS=
# Deployment only. Keep the key local; never prefix it with NEXT_PUBLIC_.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_DEPLOYER_PRIVATE_KEY=
# Optional path to the pinned Solidity 0.8.24 executable.
SOLC_BIN=
