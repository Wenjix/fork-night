{
  "name": "fork-night",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:worker": "node scripts/start-pilot-worker.mjs",
    "build": "next build",
    "build:cloudflare": "node scripts/build-waitlist-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/build-waitlist-cloudflare.mjs --deploy",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/domain/*.test.ts tests/experiments/*.test.ts tests/app/*.test.ts tests/repository/*.test.mjs",
    "test:domain": "node --test tests/domain/*.test.ts",
    "test:experiments": "node --test tests/experiments/*.test.ts",
    "test:repository": "node --test tests/repository/*.test.mjs",
    "test:pilot-db": "node scripts/test-pilot-db.mjs",
    "test:pilot-live": "node scripts/test-pilot-live.ts",
    "pilot:status": "node --env-file-if-exists=.env.local scripts/check-pilot-generation.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "submission:export": "node scripts/export-submission.mjs",
    "hosting:prepare": "node scripts/prepare-hosted-pilot.mjs",
    "experiment": "node scripts/experiment.ts",
    "experiment:openai:prepare": "node scripts/prepare-openai.ts",
    "experiment:openai": "node scripts/run-openai.ts",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:test": "node --test tests/contracts/releases.test.mjs && node --test tests/contracts/client.test.ts tests/contracts/rehearsal-check.test.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env.local scripts/deploy-releases.mjs",
    "contracts:check": "node --env-file-if-exists=.env.local scripts/check-release-rehearsal.mjs"
  },
  "dependencies": {
    "@fix-webm-duration/fix": "1.0.1",
    "@supabase/supabase-js": "2.117.2",
    "@trigger.dev/sdk": "4.6.4",
    "ethers": "6.16.0",
    "lucide-react": "0.552.0",
    "next": "16.3.5",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.4",
    "vercel": "^63.1.2"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "hardhat": "3.2.0",
    "trigger.dev": "4.6.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
