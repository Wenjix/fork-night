{
  "name": "fork-night-recovery-timer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "check": "npm run types && tsc --noEmit",
    "test": "node --test test-runtime.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "deploy:disabled": "wrangler deploy",
    "deploy:enabled": "wrangler deploy --var PILOT_TIMER_ENABLED:1"
  },
  "devDependencies": {
    "miniflare": "5.20261001.0-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
